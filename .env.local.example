# ────────────────────────────────────────────────────────────
# Copy this file to `.env.local` and fill in real values.
# Never commit `.env.local` — it is gitignored.
# ────────────────────────────────────────────────────────────

# ── Clerk (Authentication) ──
# From https://dashboard.clerk.com → your app → API Keys
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_xxxxxxxxxxxxxxxxxxxx
CLERK_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxxxxxx

# Where Clerk sends users for auth. Defaults below match the app routes.
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/admin
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL=/admin

# Only this Clerk user id (or comma-separated ids) may access /admin.
# Find yours in the Clerk dashboard → Users → (your user) → User ID.
ADMIN_USER_IDS=user_xxxxxxxxxxxxxxxxxxxx

# ── Supabase (Database) ──
# From https://app.supabase.com → your project → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOi...

# Service-role key: SERVER-ONLY. Used by admin CRUD routes. Never expose to the client.
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi...
